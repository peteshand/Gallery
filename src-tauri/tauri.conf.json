{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gallery",
  "version": "0.11.1",
  "identifier": "com.pshand.gallery",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Gallery", "width": 1100, "height": 760, "minWidth": 360, "minHeight": 520 }],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
